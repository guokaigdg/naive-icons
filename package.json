{
  "name": "naive-icons",
  "version": "1.0.2",
  "description": "Naive Icons — 手绘 naive folk art 风格的 SVG 图标库，101 个原创图标，为 React 与 TypeScript 打造",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "website": "python3 -m http.server 8080 --directory website",
    "icons:data": "python3 scripts/build_website.py",
    "icons:build": "python3 scripts/generate_icons.py && python3 scripts/build_website.py",
    "icons:add": "python3 scripts/generate_icons_add.py && python3 scripts/build_website.py"
  },
  "keywords": [
    "icons",
    "icon",
    "svg",
    "react",
    "react-icons",
    "naive",
    "folk-art",
    "hand-drawn",
    "illustration",
    "typescript",
    "design-system",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guokaigdg/naive-icons.git"
  },
  "homepage": "https://guokaigdg.github.io/naive-icons/",
  "bugs": {
    "url": "https://github.com/guokaigdg/naive-icons/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=16"
  }
}
